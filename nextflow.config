// =============================================================================
// Avalanche eDNA - Nextflow Configuration
// Profiles: local | gcp_batch | gke | tpu
// =============================================================================

manifest {
    name            = 'Avalanche-eDNA'
    author          = 'FaisalTabrez'
    description     = 'Scalable eDNA Biodiversity Assessment Pipeline'
    version         = '0.1.0'
    nextflowVersion = '>=23.10.0'
    mainScript      = 'edna_pipeline.nf'
    doi             = ''
}

// ---------- Default process labels (resource tiers) -------------------------
process {
    withLabel: process_low {
        cpus   = 2
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: process_medium {
        cpus   = 8
        memory = '32.GB'
        time   = '6.h'
    }
    withLabel: process_high_memory {
        cpus   = 16
        memory = '96.GB'
        time   = '12.h'
    }
    withLabel: process_gpu {
        cpus        = 8
        memory      = '60.GB'
        time        = '12.h'
        accelerator = 1
    }
    withLabel: process_blast {
        cpus   = 16
        memory = '64.GB'
        time   = '8.h'
    }

    // Error strategy: retry transient failures up to 3 times
    errorStrategy = { task.exitStatus in [130, 137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'
}

// ---------- Execution profiles -----------------------------------------------
profiles {

    // ---- Local (for development) --------------------------------------------
    local {
        process.executor = 'local'
        docker {
            enabled    = true
            runOptions = '--gpus all --shm-size=8g'
        }
        process {
            withLabel: process_gpu {
                containerOptions = '--gpus all'
            }
        }
    }

    // ---- GCP Batch (for large-scale runs on Google Cloud Batch) -------------
    gcp_batch {
        process.executor   = 'google-batch'
        google.project     = params.gcp_project
        google.location    = params.gcp_region
        google.batch.spot  = true    // Use Spot VMs for cost savings

        process {
            withLabel: process_low {
                machineType = 'n2-standard-4'
            }
            withLabel: process_medium {
                machineType = 'n2-standard-16'
            }
            withLabel: process_high_memory {
                machineType = 'n2-highmem-32'
            }
            withLabel: process_gpu {
                machineType     = 'n1-standard-8'
                accelerator { type = 'nvidia-tesla-t4'; count = 1 }
                // Fall back to non-Spot if GPU Spot not available
                google.batch.spot = false
            }
            withLabel: process_blast {
                machineType = 'c2-standard-30'   // Compute-optimized for BLAST
            }
        }

        // GCS working directory
        workDir           = "gs://${params.gcs_bucket}/nextflow_work"
        google.storage.enableRequesterPaysBuckets = false
    }

    // ---- GKE (Kubernetes on Google Kubernetes Engine) -----------------------
    gke {
        process.executor = 'k8s'
        k8s {
            namespace      = 'edna-production'
            serviceAccount = 'nextflow-sa'
            storageClaimName = 'edna-pvc'
            storageMountPath = '/workspace'
            pullPolicy     = 'Always'
        }
        process {
            withLabel: process_gpu {
                pod = [[nodeSelector: 'cloud.google.com/gke-accelerator=nvidia-l4']]
                resourceLimits = [[name: 'nvidia.com/gpu', quantity: 1]]
            }
            withLabel: process_high_memory {
                pod = [[nodeSelector: 'cloud.google.com/gke-nodepool=highmem']]
            }
        }
    }

    // ---- TPU Research Cloud (for large-scale training only) ------------------
    tpu {
        process.executor   = 'google-batch'
        google.project     = params.gcp_project
        google.location    = params.gcp_region
        process {
            withLabel: process_gpu {
                machineType    = 'ct4p-hightpu-4t'   // TPU v4 pod slice
                accelerator { type = 'tpu-v4-pod'; count = 4 }
            }
        }
    }

    // ---- CI testing (fast, no GPU) ------------------------------------------
    ci {
        process.executor = 'local'
        params.batch_size = 4
        params.max_cpus   = 2
        params.max_memory = '8.GB'
        docker.enabled    = false
        conda.enabled     = false
    }
}

// ---------- Reporting & Tracing ----------------------------------------------
timeline {
    enabled = true
    file    = "${params.output_dir}/reports/nextflow_timeline.html"
}

report {
    enabled = true
    file    = "${params.output_dir}/reports/nextflow_report.html"
}

trace {
    enabled = true
    file    = "${params.output_dir}/reports/nextflow_trace.txt"
    fields  = 'task_id,name,status,exit,realtime,cpus,memory,disk'
}

dag {
    enabled = true
    file    = "${params.output_dir}/reports/nextflow_dag.svg"
}
