# =============================================================================
# Avalanche eDNA - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------- Application Environment -------------------------------------------
EDNA_ENV=development           # development | testing | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ---------- GCP / Cloud -------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
ARTIFACT_REGISTRY_REGION=us-central1
ARTIFACT_REGISTRY_REPO=edna-pipeline

# ---------- Container Registry ------------------------------------------------
IMAGE_NAME=avalanche-edna
IMAGE_TAG=latest

# ---------- Database (PostgreSQL for production) -------------------------------
DB_TYPE=postgresql             # sqlite | postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edna_reports
DB_USER=edna_user
DB_PASSWORD=changeme_in_production
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- LanceDB / Vector Store --------------------------------------------
LANCEDB_URI=/app/data/lancedb          # Local path or gs://bucket/lancedb
LANCEDB_TABLE_NAME=edna_embeddings

# ---------- BLAST+ Paths (resolved at container startup from PATH) -------------
BLAST_BIN_DIR=/opt/blast/bin          # Set by Docker via PATH in container
BLASTN_PATH=/opt/blast/bin/blastn
MAKEBLASTDB_PATH=/opt/blast/bin/makeblastdb

# ---------- SRA Toolkit Paths -------------------------------------------------
SRA_BIN_DIR=/opt/sratoolkit/bin
PREFETCH_PATH=/opt/sratoolkit/bin/prefetch
FASTQ_DUMP_PATH=/opt/sratoolkit/bin/fastq-dump
FASTERQ_DUMP_PATH=/opt/sratoolkit/bin/fasterq-dump

# ---------- Data Paths (override config.yaml) ---------------------------------
DATA_RAW_DIR=/app/data/raw
DATA_PROCESSED_DIR=/app/data/processed
DATA_REFERENCE_DIR=/app/data/reference
DATA_OUTPUT_DIR=/app/data/output

# ---------- Taxonomy / NCBI taxdump -------------------------------------------
TAXDUMP_DIR=/app/data/taxdump
TAXDUMP_BACKUP_DIR=/app/data/taxdump/backups

# ---------- Reference Index Paths ---------------------------------------------
REFERENCE_BASE_DIR=/app/reference
FAISS_EMBEDDINGS_PATH=/app/reference/indices/18S/reference_embeddings.npy
FAISS_LABELS_PATH=/app/reference/indices/18S/reference_labels.csv
BLAST_DB_PREFIX=/app/reference/indices/18S/combined_18S

# ---------- HuggingFace / Model Cache -----------------------------------------
TRANSFORMERS_CACHE=/app/.cache/huggingface
HF_HOME=/app/.cache/huggingface
# Optional: set a HF token for gated models
# HUGGINGFACE_HUB_TOKEN=hf_xxxxxxxxxxxx

# ---------- MLflow Tracking ---------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000    # or a Vertex AI / remote URI
MLFLOW_EXPERIMENT_NAME=avalanche-edna

# ---------- GCS (for cloud storage of datasets and artifacts) ------------------
GCS_BUCKET_NAME=your-edna-data-bucket
GCS_DATA_PREFIX=datasets/
GCS_MODELS_PREFIX=models/

# ---------- Performance -------------------------------------------------------
N_JOBS=-1                    # Number of parallel jobs (-1 = all cores)
CHUNK_SIZE=1000
USE_GPU=true
GPU_MEMORY_FRACTION=0.8
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# ---------- Pipeline Stages (feature flags) -----------------------------------
ENABLE_PREPROCESSING=true
ENABLE_EMBEDDING=true
ENABLE_CLUSTERING=true
ENABLE_TAXONOMY=true
ENABLE_NOVELTY_DETECTION=true
ENABLE_CONTINUAL_LEARNING=false
